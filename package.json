{
  "name": "toronto-toy-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "tsx scripts/gzip-data.ts && vite build && tsx scripts/prune-dist.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "data": "npm run data:toronto && npm run data:geo",
    "data:toronto": "tsx scripts/build-toronto.ts",
    "data:geo": "tsx scripts/build-geo.ts",
    "check": "tsx scripts/check-toronto.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "csv-parse": "^7.0.2",
    "fflate": "^0.8.3",
    "gtfs-realtime-bindings": "^2.2.0",
    "pbf": "^5.1.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.139.0"
  }
}
