{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toronto-toy-map",
  "main": "worker/main.ts",
  "workers_dev": true,
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API and the page shell (per-URL OpenGraph tags) run code; data and assets come straight from the edge.
    "run_worker_first": ["/api/*", "/"]
  },
  // Static schedule/network files are bundled as plain text and parsed once inside the Durable Object.
  "rules": [{ "type": "Text", "globs": ["**/data/**/*.json"], "fallthrough": false }],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "CityHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CityHub"] }],
  "observability": { "enabled": true }
}
